package demo;

import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.Keys;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.chrome.ChromeOptions;

public class BigBasket {
	public static void main(String[] args) throws InterruptedException {
		    WebDriver driver=new ChromeDriver();
		    driver.manage().window().maximize();
		    driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
		    driver.get("https://www.bigbasket.com/pb/boss/");
		    WebElement search = driver.findElement(By.xpath("//input[contains(@placeholder,'Search')]"));
        search.sendKeys("Choclate");
        search.sendKeys(Keys.ENTER);
        Thread.sleep(2000);
        JavascriptExecutor js = (JavascriptExecutor)driver;
        js.executeScript("window.scrollTo(0,500)");
        driver.findElement(By.xpath("(//button[text()='Add'])[1]")).click();
        
        String url = driver.getCurrentUrl();

		if (url.contains("https://www.bigbasket.com/ps/?q=Choclate&nc=as"))
			System.out.println("Added to basket");
		else
			System.out.println("Not added");
	}

}
