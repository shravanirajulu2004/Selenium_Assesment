//VacanciesPage

package pompages;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.FindBy;
import org.openqa.selenium.support.PageFactory;

public class VacanciesPage {

    WebDriver driver;

    public VacanciesPage(WebDriver driver) {
        this.driver = driver;
        PageFactory.initElements(driver, this);
    }

    // Recruitment link
    @FindBy(xpath = "//span[text()='Recruitment']")
    private WebElement Recruitment;

    // Vacancies link
    @FindBy(xpath = "//a[text()='Vacancies']")
    private WebElement Vacancies;

    // Add button
    @FindBy(xpath = "//button[normalize-space()='Add']")
    private WebElement Add;

    // Vacancy Name
    @FindBy(xpath = "//label[text()='Vacancy Name']/following::input[1]")
    private WebElement VacancyName;

    // Job Title
    @FindBy(xpath = "//label[text()='Job Title']/following::div[contains(@class,'oxd-select-text')][1]")
    private WebElement JobTitle;

    // Description
    @FindBy(xpath = "//label[text()='Description']/following::textarea[1]")
    private WebElement Description;

    // Hiring Manager
    @FindBy(xpath = "//label[text()='Hiring Manager']/following::input[1]")
    private WebElement HiringManager;

    // Number of Positions
    @FindBy(xpath = "//label[text()='Number of Positions']/following::input[1]")
    private WebElement NumberOfPositions;

    // Save button
    @FindBy(css = "button[type='submit']")
    private WebElement SaveButton;


    // Click Recruitment
    public void getRecruitment() {
        Recruitment.click();
    }

    // Click Vacancies
    public void getVacancies() {
        Vacancies.click();
    }

    // Click Add
    public void getAdd() {
        Add.click();
    }


    // Enter Vacancy Name
    public void getVacancyName(String vacancyName) {
        VacancyName.sendKeys(vacancyName);
    }


    // Select Job Title
    public void getJobTitle(String jobTitle) {

        JobTitle.click();

        driver.findElement( By.xpath("//div[@role='option']//span[normalize-space()='"+ jobTitle + "']")).click();
    }


    // Enter Description
    public void getDescription(String description) {
        Description.sendKeys(description);
    }


    public void getHiringManager(String hiringManager) {

        HiringManager.sendKeys(hiringManager);

        driver.findElement(By.xpath("//div[contains(@class,'oxd-autocomplete-option')]//span[normalize-space()='" + hiringManager + "']")).click();
    }

    // Enter Number of Positions
    public void getNumberOfPositions(String positions) {
        NumberOfPositions.sendKeys(positions);
    }


    // Click Save
    public void getSave() {
        SaveButton.click();
    }
}
