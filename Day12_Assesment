package usingTestNg;

import java.io.FileInputStream;
import java.io.IOException;

import org.apache.poi.ss.usermodel.DataFormatter;
import org.apache.poi.ss.usermodel.Sheet;
import org.apache.poi.ss.usermodel.Workbook;
import org.apache.poi.ss.usermodel.WorkbookFactory;
import org.testng.annotations.DataProvider;
import org.testng.annotations.Test;

import baseClassUtility.HrmBaseClass;
import pompages.VacanciesPage;

public class VacanciesTest extends HrmBaseClass {

    @DataProvider(name = "vacancyData")
    public Object[][] getVacancyData() throws IOException {

        FileInputStream fis = new FileInputStream("./src/test/resources/DTT/hrmsample.xlsx");

        Workbook wb = WorkbookFactory.create(fis);

        Sheet sh = wb.getSheet("Sheet1");

        DataFormatter df = new DataFormatter();

        int rowCount = sh.getLastRowNum();
        int cellCount = sh.getRow(0).getLastCellNum();

        Object[][] obj = new Object[rowCount][cellCount];

        for (int row = 1; row <= rowCount; row++) {

            for (int col = 0; col < cellCount; col++) {

                obj[row - 1][col] =
                        df.formatCellValue(sh.getRow(row).getCell(col));
            }
        }

        wb.close();
        fis.close();

        return obj;
    }

    @Test(dataProvider = "vacancyData")
    public void createVacancy(	
            String firstName,
            String middleName,
            String lastName,
            String vacancyName,
            String jobTitle,
            String description,
            String hiringManager,
            String numberOfPositions)
            throws IOException, InterruptedException {

        // Login is already handled by Base Class

        VacanciesPage vacancy = new VacanciesPage(driver);

        vacancy.getRecruitment();
        vacancy.getVacancies();
        vacancy.getAdd();

        vacancy.getVacancyName(vacancyName);
        vacancy.getJobTitle(jobTitle);
        vacancy.getDescription(description);
        vacancy.getHiringManager(hiringManager);
        vacancy.getNumberOfPositions(numberOfPositions);

        vacancy.getSave();

        Thread.sleep(2000);
    }
}

