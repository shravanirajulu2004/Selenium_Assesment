//Java Test Scripts

package usingTestNg;

import java.io.FileInputStream;
import java.io.IOException;

import org.apache.poi.EncryptedDocumentException;
import org.apache.poi.ss.usermodel.DataFormatter;
import org.apache.poi.ss.usermodel.Workbook;
import org.apache.poi.ss.usermodel.WorkbookFactory;
import org.testng.annotations.Test;
import baseClassUtility.SauceBaseClass;
import pomutilites.SauceCartPage;
import pomutilites.SauceCheckoutPage;
import pomutilites.SauceLoginPage;
import pomutilites.SauceProductPage;

public class SauceTest extends SauceBaseClass { 

	@Test
	public void loginTest() {

	    SauceLoginPage login = new SauceLoginPage(driver);

	    login.getUsername(Username);
	    login.getPassword(password);
	    login.getLogin();

	    SauceProductPage product = new SauceProductPage(driver);

	    System.out.println(product.getProducts());
	}
	
	@Test(dependsOnMethods = "loginTest")
	public void orderPlacementTest() throws EncryptedDocumentException, IOException {
		
		FileInputStream excel = new FileInputStream(
		        "./src/test/resources/DTT/sauce.xlsx");

		Workbook wb = WorkbookFactory.create(excel);

		DataFormatter df = new DataFormatter();

		String firstName = df.formatCellValue(
		        wb.getSheet("Sheet1").getRow(1).getCell(0));

		String lastName = df.formatCellValue(
		        wb.getSheet("Sheet1").getRow(1).getCell(1));

		String postalCode = df.formatCellValue(
		        wb.getSheet("Sheet1").getRow(1).getCell(2));
		SauceProductPage product = new SauceProductPage(driver);

		product.addBackpack();

		System.out.println("Cart count: " + product.getCartCount());

		if (product.getCartCount().equals("1")) {
		    System.out.println("Cart contains 1 item");
		} else {
		    System.out.println("Cart does not contain 1 item");
		}
		product.getCart();
	    
		SauceCartPage cart = new SauceCartPage(driver);

		System.out.println(cart.getBackpackName());
		
		SauceCheckoutPage checkout = new SauceCheckoutPage(driver);

		checkout.clickCheckout();
		checkout.enterFirstName(firstName);
		checkout.enterLastName(lastName);
		checkout.enterPostalCode(postalCode);
		checkout.clickContinue();
		System.out.println(checkout.getOverview());
		checkout.clickFinish();
		System.out.println(checkout.getConfirmationMessage());
	}
}
