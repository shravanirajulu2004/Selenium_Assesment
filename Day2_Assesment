**Test Case1**
  
1.Navigate to the facebook application.
2.Click on create new account button.
3.Verify that fistname and surname textfields are aligned in same line or not.


package selenium_assesments;

import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.Point;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;

public class Day2_TestCase1 {

	public static void main(String[] args) throws InterruptedException {
		WebDriver driver = new ChromeDriver();
		driver.manage().window().maximize();
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
		driver.get("https://facebook.com/");
		driver.findElement(By.xpath("//span[text()='Create new account']")).click();
		Thread.sleep(2000);
		Point firstNameLocation = driver.findElement(By.xpath("//label[text()='First name']")).getLocation();
		Point surnameLocation = driver.findElement(By.xpath("//label[text()='Surname']")).getLocation();
		System.out.println("First Name Location: " + firstNameLocation);
		System.out.println("Surname Location: " + surnameLocation);
		if (firstNameLocation.getY() == surnameLocation.getY()) {
		    System.out.println("First Name and Surname are aligned in the same line.");
		} else {
		    System.out.println("First Name and Surname are NOT aligned in the same line.");
		}

	}

}

