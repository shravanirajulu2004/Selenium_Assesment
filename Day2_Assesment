1.Navigate to facebook application 
2.capture the location of create new account button.
3.Capture the Dom Attribute and dom property for email address textfield before and after entering email address
4.click on create new account capture the size of submit button
5.capture the css properties of submit button (minimum 3).


package selenium_assesments;

import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;

public class Day2_TestCase2 {

	public static void main(String[] args) throws InterruptedException {
		WebDriver driver = new ChromeDriver();
		driver.manage().window().maximize();
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
		driver.get("https://facebook.com/");
		//capturing location
		WebElement createacc = driver.findElement(By.xpath("//span[text()='Create new account']"));
		System.out.println("Create Account Location: "+ createacc.getLocation());
		// Click
		createacc.click();

		Thread.sleep(2000);
		WebElement email = driver.findElement(By.id("_R_6ad8p4jikacppb6amH1_"));
		//getDomAttribute
		System.out.println(email.getDomAttribute("value"));
		System.out.println(email.getDomProperty("value"));
		email.sendKeys("kai06@gmail.com");
		Thread.sleep(2000);
		//after entering value
		System.out.println(email.getDomAttribute("value"));
		System.out.println(email.getDomProperty("value"));
		
		//size of button
		WebElement submitbtn = driver.findElement(By.xpath("//span[normalize-space()='Submit']/ancestor::div[@role='none'][2]"));
		System.out.println("submit box size"+submitbtn.getSize());
		System.out.println("Height: "+submitbtn.getSize().getHeight());
		System.out.println("Width: "+submitbtn.getSize().getWidth());
		//css attribute
		System.out.println("Background Color: "+submitbtn.getCssValue("background-color"));
		System.out.println("Color: "+submitbtn.getCssValue("color"));
		System.out.println("Font Size: "+submitbtn.getCssValue("font-size"));
		System.out.println("Font weight: "+submitbtn.getCssValue("font-weight"));
		

	}

}

