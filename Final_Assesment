package assesment;

import java.time.Duration;

import java.util.List;


import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;

public class TestCase1 {
	public static void main(String[] args) throws InterruptedException {
		WebDriver driver = new ChromeDriver();
		driver.manage().window().maximize();
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
		driver.get("https://demoapps.qspiders.com/ui/toggle?sublist=0");
		List<WebElement> toggles =driver.findElements(By.xpath("//span[@class='absolute left-[3px] top-[2px] translate-x-0 inline-block w-3 h-3 transition duration-300 ease-in-out transform bg-white border border-gray-300 rounded-full']"));
        toggles.get(0).click();
        Thread.sleep(2000);
        toggles.get(1).click();
        Thread.sleep(2000);
        toggles.get(2).click();
        Thread.sleep(2000);
        toggles.get(3).click();
        driver.findElement(By.id("togglers")).click();
        driver.quit();
		String url = driver.getCurrentUrl();

		if (url.contains("https://demoapps.qspiders.com/ui/image")) {
		    System.out.println("order placed");
		} else {
		    System.out.println("order has not placed");
		}
		}
	}

